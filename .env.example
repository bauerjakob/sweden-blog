# Copy to .env and fill in. docker compose reads this automatically.

# REQUIRED — signs session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-hex-string

# Your real public URL (used for absolute Open Graph image links + sitemap).
SITE_URL=https://blog.bauer-jakob.de

# Host port to expose the site on.
PORT=8086

# Seeds the single admin user on first boot (only when no user exists yet).
# Remove after the first run if you like; the account persists in the volume.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me-too
