{
  "name": "sweden-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.mjs",
    "dev:full": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:dev:server\"",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "photos": "node scripts/resize-photos.mjs",
    "seed:admin": "node server/seed-admin.mjs"
  },
  "browserslist": [
    ">0.3%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "js-yaml": "^4.3.2",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^14.3.1",
    "multer": "^2.3.0",
    "sharp": "^0.35.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^10.0.5",
    "suncalc": "^1.9.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
